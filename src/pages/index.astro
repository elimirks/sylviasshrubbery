---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Cat from "../widgets/Cat.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
  </head>
  <body>
    <Header />
    <main>
      <h1><span class="wave">👋</span> Welcome <span class="wave">👋</span></h1>

      <img
        src="/images/logo/logo_graphic.png"
        alt="Sylvia's Shrubbery"
        class="logo-icon"
      />

      <p style="margin-bottom: 2em">
        My name is Sylvia Mirecki. I'm a Canadian programmer with a focus on
        high performance and distributed computing, especially with Rust! I
        usually write about technical topics in my blog, but occasionally other
        topics as well. I'm also a strong believer in fun-oriented-programming
        when possible :)
      </p>

      <Cat />
      <p style="margin-top: 2em;">
        Until I think of something better to put here, check out my <a
          href="/blog">blog</a
        > or <a href="/about">about page</a>!
      </p>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
  }

  img.logo-icon {
    align-self: center;
    max-width: 200px;
    margin: 2em 0;
  }

  h1 {
    text-align: center;
    margin-top: 0.5em;
  }

  @media (max-width: 600px) {
    span.wave {
      display: none;
    }
  }
</style>
