---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Cat from "../widgets/Cat.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
  </head>
  <body>
    <Header />
    <main>
      <h1>Welcome!</h1>

      <img
        src="/images/logo/logo_graphic.png"
        alt="Sylvia's Shrubbery"
        class="logo-icon"
      />
      <p>idk what to put on the home page, check out the other pages</p>

      <Cat />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
  }

  img.logo-icon {
    align-self: center;
    max-width: 200px;
    margin: 3em 0;
  }

  h1 {
    text-align: center;
    margin-top: 1em;
  }
</style>
