  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
  }

  img.logo-icon {
    align-self: center;
    max-width: 200px;
    margin: 2em 0;
  }

  h1 {
    text-align: center;
    margin-top: 0.5em;
  }

  @media (max-width: 600px) {
    span.wave {
      display: none;
    }
  }
</style>
