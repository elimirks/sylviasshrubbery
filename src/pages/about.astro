</Layout>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    margin: 0;
    padding: 0;
  }

  .timeline-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.5em;
  }

  .year {
    min-width: 4em;
    font-weight: bold;
    color: #555;
    flex-shrink: 0;
  }

  .desc {
    flex: 1;
  }

  /* Mobile layout: stack year above desc */
  @media (max-width: 600px) {
    .timeline-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2em;
    }
    .year {
      min-width: 0;
      margin-bottom: 0.1em;
    }
  }

  .sub-heading {
    margin-top: 2em;
  }

  .license {
    font-family: monospace;
    background-color: #f4f4f4;
    white-space: pre-wrap;
  }
</style>
