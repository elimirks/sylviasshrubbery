---
import AboutHeroImage from "../assets/blog-placeholder-about.jpg";
import Layout from "../layouts/BlogPost.astro";
---

<Layout
  title="About Me"
  description="Sylvia's programming journey"
  pubDate={new Date("September 04 2026")}
  heroImage={AboutHeroImage}
>
  <div class="timeline">
    <div class="timeline-row">
      <span class="year">2026</span><span class="desc"
        >Looking for work! Contact me if you're interested :)</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2023</span><span class="desc"
        >Co-Founder &amp; CTO at Searchless Inc.</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2022</span><span class="desc"
        >Software Engineer at Dropbox, working on their core storage team</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2020</span><span class="desc"
        >Software Engineer at Amazon, working on Alexa</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2019</span><span class="desc"
        >Software Developer at Jonah Group</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2019</span><span class="desc"
        >Graduated from the University of Toronto with an HBSc in Physics and
        Computer Science</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2018</span><span class="desc"
        >Various contracts while I finished my final year of university</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2017</span><span class="desc"
        >Took a year off school to work as an Embedded Software Engineer Intern
        at Verity</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2016</span><span class="desc"
        >Summer contract at UofT to improve their lab grading software</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2015</span><span class="desc"
        >I liked first year Physics courses, so started a second major</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2014</span><span class="desc"
        >Attended the University of Toronto for Computer Science</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2012</span><span class="desc"
        >Started working part time building Android and iOS apps</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2011</span><span class="desc"
        >Started taking online uni courses</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2007</span><span class="desc"
        >Started learning ActionScript so I could turn my Flash animations into
        games</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">2002</span><span class="desc"
        >Started learning HTML so I could plagiarize content from my bug books</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">1999</span><span class="desc"
        >Learned how to type "W I N [enter]" in DOS so I can play in Windows 3.1</span
      >
    </div>
    <div class="timeline-row">
      <span class="year">1996</span><span class="desc">Hello, world</span>
    </div>
  </div>
</Layout>
<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    margin: 0;
    padding: 0;
  }
  .timeline-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.5em;
  }
  .year {
    min-width: 4em;
    font-weight: bold;
    color: #555;
    flex-shrink: 0;
  }
  .desc {
    flex: 1;
  }

  /* Mobile layout: stack year above desc */
  @media (max-width: 600px) {
    .timeline-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2em;
    }
    .year {
      min-width: 0;
      margin-bottom: 0.1em;
    }
  }
</style>
