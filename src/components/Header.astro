---
import HeaderLink from "./HeaderLink.astro";
---

<header>
  <nav>
    <h2>
      <a href="/" class="logo">
        <img
          src="/images/logo/logo_long.png"
          alt="Sylvia's Shrubbery"
          id="logo-long"
        />
        <img
          src="/images/logo/logo_narrow.png"
          alt="Sylvia's Shrubbery"
          id="logo-icon"
        />
      </a>
    </h2>

    <!-- Hamburger Toggle Button -->
    <button
      id="menu-toggle"
      class="hamburger"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <img src="/icons/boring-burger.svg" alt="Menu" id="burg-boring" />
      <img src="/icons/burger.svg" alt="Menu" id="burg" />
    </button>

    <div id="nav-links" class="internal-links">
      <HeaderLink href="/" class="nav-link">Home</HeaderLink>
      <HeaderLink href="/blog" class="nav-link">Blog</HeaderLink>
      <HeaderLink href="/art" class="nav-link">Art</HeaderLink>
      <HeaderLink href="/about" class="nav-link">About</HeaderLink>
    </div>
  </nav>
</header>

<script>
  // Runs client-side automatically in vanilla Astro
  function setupMenu() {
    const toggleBtn = document.getElementById("menu-toggle");
    const navLinks = document.getElementById("nav-links");
    const boringBurg = document.getElementById("burg-boring");
    const burg = document.getElementById("burg");

    if (!toggleBtn || !navLinks) return;

    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", (!isExpanded).toString());
      navLinks.classList.toggle("open");

      if (isExpanded) {
        boringBurg.style.display = "block";
        burg.style.display = "none";
      } else {
        boringBurg.style.display = "none";
        burg.style.display = "block";
      }
    });
  }

  setupMenu();

  // Support Astro View Transitions if re-navigating
  document.addEventListener("astro:after-swap", setupMenu);
</script>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    position: relative;
  }

  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  nav a {
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }

  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .logo img#logo-long {
    max-width: 300px;
    height: auto;
  }

  .logo img#logo-icon {
    max-height: 40px;
    transform: scale(1.4);
    margin-top: 0.2em;
    margin-left: 0.8em;
    margin-bottom: -0.2em;
    width: auto;
  }

  @media (max-width: 500px) {
    .logo img#logo-icon {
      display: block;
    }

    .logo img#logo-long {
      display: none;
    }
  }

  @media (min-width: 501px) {
    .logo img#logo-icon {
      display: none;
    }

    .logo img#logo-long {
      display: block;
    }
  }

  .internal-links {
    display: flex;
    gap: 1em;
  }

  /* Hamburger Icon Styling */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 21px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 10;
  }

  .hamburger img#burg-boring {
    display: block;
  }

  .hamburger img#burg {
    display: none;
  }

  /* Mobile Responsive Dropdown Styles */
  @media (max-width: 720px) {
    .hamburger {
      display: flex;
    }

    .internal-links {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: white;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      padding: 1em 0;
      align-items: center;
    }

    .internal-links.open {
      display: flex;
      z-index: 5;
    }

    .internal-links .nav-link {
      padding: 0.5em 1em;
      width: 100%;
      text-align: center;
    }
  }
</style>
